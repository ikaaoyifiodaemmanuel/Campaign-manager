# ─────────────────────────────────────────────
#  Campaign Manager — Environment Variables
#  Copy this to .env and fill in real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://campaign:secret@postgres:5432/campaign_manager
POSTGRES_USER=campaign
POSTGRES_PASSWORD=secret
POSTGRES_DB=campaign_manager

# Redis
REDIS_URL=redis://redis:6379

# Local file storage (Docker volume mounted at /uploads)
UPLOADS_PATH=/uploads

# OpenAI — model/voice choice only; the API key itself is no longer a
# shared env var (Phase 2, BYO keys). Each organization brings its own
# OpenAI/Pexels key via the dashboard's Settings page, encrypted at rest
# (see TENANT_KEY_ENCRYPTION_KEY below) — there is deliberately no
# OPENAI_API_KEY/PEXELS_API_KEY here anymore.
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Twitter / X — posting is browser automation (see docs/setup.md for the
# one-time login step), no API keys needed for it. Bearer token is still
# used by analytics-service for read-only metrics.
TWITTER_BEARER_TOKEN=
# Slug for the FIRST Twitter/X account only — seeded into the `accounts`
# table on first startup. The system supports multiple accounts (2-5); add
# any account after this one via the dashboard's /accounts page, not env
# vars (see docs/setup.md step 5a and "Multi-account support" in
# docs/services.md).
PUBLISHER_TWITTER_ACCOUNT=default
PUBLISHER_HEADLESS=false

# TikTok — posting is browser automation too (one-time login:
# `python browser/setup_session.py <slug> tiktok`), no API keys. Session
# profiles live in an OS-appropriate app-data dir by default (see
# apps/publisher-service/paths.py) — override below to pin a fixed location
# instead (this repo's own real .env does, pointing at ./tiktok_session_data
# and ./twitter_session_data, since that's where its real accounts' sessions
# already lived before this became the default).
# TIKTOK_SESSION_PATH=
# TWITTER_SESSION_PATH=
# Real browser timezone_id by default (tzlocal) — override only if an
# existing session was created under a different hardcoded zone and you
# need to keep matching it (a zone change on an already-logged-in session
# is itself a fingerprint-drift signal to X/TikTok's bot detection).
# BROWSER_TIMEZONE=

# Publisher client credentials (Phase 4) — publisher-service polls the
# hosted backend for publish jobs instead of accepting inbound requests;
# it needs its own client key to do that. Create one on the Settings
# page's "Publisher Clients" section, paste the raw key here (shown only
# once at creation). CAMPAIGN_MANAGER_API_URL is api-gateway's own
# publicly-reachable URL — http://localhost:3000 for local dev, since
# publisher-service runs on the host and api-gateway's port is published
# there (see docker-compose.yml), not the in-Docker-network
# http://api-gateway:3000 every containerized service uses instead.
CAMPAIGN_MANAGER_API_URL=http://localhost:3000
# CAMPAIGN_MANAGER_CLIENT_KEY=
# PUBLISHER_POLL_INTERVAL_SECONDS=8

# Internal service URLs (used by api-gateway to call other services)
MEDIA_SERVICE_URL=http://media-service:5001
CONTENT_SERVICE_URL=http://content-service:5002
# publisher-service runs on the host, not in Docker (see docs/setup.md) —
# host.docker.internal lets containers reach it (Docker Desktop only).
PUBLISHER_SERVICE_URL=http://host.docker.internal:5003
ANALYTICS_SERVICE_URL=http://analytics-service:5004

# Orchestrator — autonomous posting streams (see docs/services.md)
ORCHESTRATOR_POLL_INTERVAL=60
ORCHESTRATOR_TIKTOK_INTERVAL_MINUTES=60
ORCHESTRATOR_TIKTOK_DAILY_CAP=10
ORCHESTRATOR_NICHE_INTERVAL_MINUTES=60
ORCHESTRATOR_NICHE_DAILY_CAP=10
ORCHESTRATOR_NICHE_REFILL_THRESHOLD=5
# Auto-reel is much heavier per-run (real TTS + GPT script + Pexels + ffmpeg
# + Whisper transcription) than the other two streams — ships disabled by
# default (see automation_settings.reel_enabled); tune from the dashboard.
ORCHESTRATOR_REEL_INTERVAL_MINUTES=240
ORCHESTRATOR_REEL_DAILY_CAP=2
ORCHESTRATOR_REEL_REFILL_THRESHOLD=3

# JWT Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Seeds the first platform admin (see docs/services.md's admin section) —
# that email's user gets granted admin access on every media-service
# startup, self-healing if the grant is ever lost. Every admin added after
# that is DB-driven (Admin page's "Add admin"), not this env var — leave
# it set permanently for the account you want as a standing break-glass
# admin, or unset it once you don't need that safety net.
PLATFORM_ADMIN_EMAIL=

# Tenant API key encryption (Phase 2 — BYO OpenAI/Pexels keys, see
# apps/media-service/db.py::encrypt_value/decrypt_value). AES-256-GCM needs
# a 32-byte key, base64-encoded here. Generate one with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Losing/rotating this key makes every already-stored tenant key
# undecryptable — treat it like any other production secret, never commit
# a real value.
TENANT_KEY_ENCRYPTION_KEY=DBAHSctzhqYYklq9t1BLs7NVB61uldfIkt0T83B02xk=

# Object storage (Phase 3 — media no longer lives on local disk/shared
# volumes; api-gateway and worker upload to this instead). Locally this
# points at the MinIO container (S3-API-compatible); in production it
# points at a real DigitalOcean Spaces bucket — same SDK calls, only these
# values change. S3_ENDPOINT is the internal address containers use to
# upload; S3_PUBLIC_URL_BASE is the prefix used to build URLs handed back
# to the browser/publisher-service, which reach it from the host, not the
# Docker network — the two are only the same host in Spaces, never in
# local dev. S3_FORCE_PATH_STYLE=true is required for MinIO (path-style
# addressing); Spaces uses virtual-hosted-style, so this becomes false
# there — see docs/setup.md once Phase 5 documents the production values.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL_BASE=http://localhost:9000/campaign-manager-media
S3_REGION=us-east-1
S3_BUCKET=campaign-manager-media
S3_ACCESS_KEY=change-me-in-production
S3_SECRET_KEY=change-me-in-production
S3_FORCE_PATH_STYLE=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
